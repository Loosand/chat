{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_EMAIL_FROM",
        "BETTER_AUTH_ADMIN_USER_IDS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "CHAT_MODEL_ALLOW_PRIVATE_NETWORK",
        "CHAT_MODEL_BASE_URL",
        "CHAT_MODEL_DISPLAY_NAME",
        "CHAT_MODEL_KEY",
        "CHAT_MODEL_NAME",
        "CHAT_MODEL_PROTOCOL",
        "CHAT_MODEL_PROVIDER",
        "CHAT_MODEL_SYSTEM_PROMPT",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "JOB_DRIVER",
        "PROVIDER_CREDENTIAL_ENCRYPTION_KEY",
        "REDIS_URL",
        "RESEND_API_KEY",
        "STORAGE_DRIVER",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "env": [
        "AUTH_EMAIL_FROM",
        "BETTER_AUTH_ADMIN_USER_IDS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "CHAT_MODEL_ALLOW_PRIVATE_NETWORK",
        "CHAT_MODEL_BASE_URL",
        "CHAT_MODEL_DISPLAY_NAME",
        "CHAT_MODEL_KEY",
        "CHAT_MODEL_NAME",
        "CHAT_MODEL_PROTOCOL",
        "CHAT_MODEL_PROVIDER",
        "CHAT_MODEL_SYSTEM_PROMPT",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "JOB_DRIVER",
        "PROVIDER_CREDENTIAL_ENCRYPTION_KEY",
        "REDIS_URL",
        "RESEND_API_KEY",
        "STORAGE_DRIVER",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "passThroughEnv": ["CHAT_MODEL_API_KEY"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
