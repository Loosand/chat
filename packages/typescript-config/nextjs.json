{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Chat Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/*": ["../../packages/*"]
    },
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
