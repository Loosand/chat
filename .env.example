# Core infrastructure.
DATABASE_URL=
DATABASE_POOL_MAX=
POSTGRES_PASSWORD=
CHAT_PORT=3000

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_ADMIN_USER_IDS=

# Transactional auth email (Resend works on Vercel and Docker).
RESEND_API_KEY=
AUTH_EMAIL_FROM="Chat <auth@example.com>"

# Optional first text model. Set provider + model name to bootstrap all four
# catalog records; official providers also require CHAT_MODEL_API_KEY.
CHAT_MODEL_PROVIDER=
CHAT_MODEL_NAME=
CHAT_MODEL_API_KEY=
CHAT_MODEL_BASE_URL=
CHAT_MODEL_PROTOCOL=
CHAT_MODEL_KEY=default
CHAT_MODEL_DISPLAY_NAME=
CHAT_MODEL_SYSTEM_PROMPT=
CHAT_MODEL_ALLOW_PRIVATE_NETWORK=false

# Optional future infrastructure.
REDIS_URL=
STORAGE_DRIVER=local
JOB_DRIVER=inline
